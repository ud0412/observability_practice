{
  "id": null,
  "uid": "lab-services-fixed",
  "title": "Lab Services Fixed Example",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "practice"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name)(rate(http_server_request_duration_seconds_count{service_name=~\"sample-spring-boot\",http_route=\"/test\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Error percentage",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{service_name=~\"sample-spring-boot\",http_route=\"/test\",http_response_status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{service_name=~\"sample-spring-boot\",http_route=\"/test\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "p95 response time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,service_name)(rate(http_server_request_duration_seconds_bucket{service_name=~\"sample-spring-boot\",http_route=\"/test\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "JVM memory used (Java service)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{service_name=~\"sample-spring-boot\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Server logs → trace",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"sample-app\",service_name=~\"sample-spring-boot\"} | json",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "title": "Requests in 15 minutes",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name)(increase(http_server_request_duration_seconds_count{service_name=~\"sample-spring-boot\",http_route=\"/test\"}[15m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "xField": "service_name",
        "orientation": "vertical"
      }
    }
  ]
}
